<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackground"     Color="#1E1E1E"/>
    <SolidColorBrush x:Key="PanelBackground"   Color="#252525"/>
    <SolidColorBrush x:Key="InputBackground"   Color="#2A2A2A"/>
    <SolidColorBrush x:Key="BorderColor"       Color="#3A3A3A"/>
    <SolidColorBrush x:Key="InputBorder"       Color="#444444"/>
    <SolidColorBrush x:Key="TextPrimary"       Color="#F0F0F0"/>
    <SolidColorBrush x:Key="TextSecondary"     Color="#A0A0A0"/>
    <SolidColorBrush x:Key="ButtonAlt"         Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ButtonAltBorder"   Color="#606060"/>
</ResourceDictionary>
