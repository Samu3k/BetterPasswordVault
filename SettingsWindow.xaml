<Window x:Class="BetterPasswordVault.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impostazioni" Height="660" Width="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{DynamicResource SettingsTitle}" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <Separator Background="{DynamicResource BorderColor}" Margin="0,12,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <TextBlock Text="{DynamicResource SectionAccount}" Foreground="{DynamicResource TextSecondary}"
                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LabelChangePassword}" Foreground="{DynamicResource TextPrimary}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock Text="{DynamicResource LabelCurrentPassword}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="OldPasswordBox" Height="36" FontSize="13"
                                     Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}"
                                     BorderBrush="{DynamicResource InputBorder}" Padding="10,6" Margin="0,0,0,10"/>
                        <TextBlock Text="{DynamicResource LabelNewPassword}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="NewPasswordBox" Height="36" FontSize="13"
                                     Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}"
                                     BorderBrush="{DynamicResource InputBorder}" Padding="10,6" Margin="0,0,0,10"/>
                        <TextBlock Text="{DynamicResource LabelConfirmNewPassword}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="ConfirmPasswordBox" Height="36" FontSize="13"
                                     Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}"
                                     BorderBrush="{DynamicResource InputBorder}" Padding="10,6" Margin="0,0,0,12"/>
                        <Button Content="{DynamicResource BtnUpdatePassword}" Height="36"
                                Background="#3A7BFF" Foreground="White" BorderThickness="0"
                                FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Left" Width="200"
                                Click="ChangePassword_Click"/>
                        <TextBlock x:Name="PasswordStatusText" Foreground="#FF7070" FontSize="12" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource LabelDeleteAccount}" Foreground="#F87171"
                                       FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource LabelDeleteAccountDesc}"
                                       Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{DynamicResource BtnDelete}" Width="90" Height="34"
                                Background="#7F1D1D" Foreground="White" BorderThickness="0" FontSize="13"
                                VerticalAlignment="Center" Click="DeleteAccount_Click"/>
                    </Grid>
                </Border>

                <TextBlock Text="{DynamicResource SectionBackup}" Foreground="{DynamicResource TextSecondary}"
                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource LabelExportVault}" Foreground="{DynamicResource TextPrimary}"
                                       FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource LabelExportVaultDesc}"
                                       Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{DynamicResource BtnExport}" Width="90" Height="34"
                                Background="#16A34A" Foreground="White" BorderThickness="0" FontSize="13"
                                VerticalAlignment="Center" Click="ExportVault_Click"/>
                    </Grid>
                </Border>

                <TextBlock Text="{DynamicResource SectionAppearance}" Foreground="{DynamicResource TextSecondary}"
                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LabelTheme}" Foreground="{DynamicResource TextPrimary}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource LabelThemeDesc}"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,10"/>
                        <ComboBox x:Name="ThemeCombo" Height="34" Width="160" HorizontalAlignment="Left"
                                  Background="White" Foreground="#1E1E1E"
                                  BorderBrush="{DynamicResource InputBorder}" FontSize="13"
                                  Margin="0,0,0,10" SelectionChanged="ThemeCombo_Changed">
                            <ComboBoxItem Content="{DynamicResource ThemeDark}" IsSelected="True"/>
                            <ComboBoxItem Content="{DynamicResource ThemeLight}"/>
                        </ComboBox>
                        <Button Content="{DynamicResource BtnSaveTheme}" Height="34" Width="140"
                                HorizontalAlignment="Left" Background="#3A7BFF" Foreground="White"
                                BorderThickness="0" FontSize="13" Click="SaveTheme_Click"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource SectionLanguage}" Foreground="{DynamicResource TextSecondary}"
                           FontSize="11" FontWeight="SemiBold" Margin="0,16,0,10"/>

                <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource LabelLanguage}" Foreground="{DynamicResource TextPrimary}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource LabelLanguageDesc}"
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,10"/>
                        <ComboBox x:Name="LangCombo" Height="34" Width="160" HorizontalAlignment="Left"
                                  Background="White" Foreground="#1E1E1E"
                                  BorderBrush="{DynamicResource InputBorder}" FontSize="13"
                                  Margin="0,0,0,10" SelectionChanged="LangCombo_Changed">
                            <ComboBoxItem Content="{DynamicResource LangIT}" IsSelected="True"/>
                            <ComboBoxItem Content="{DynamicResource LangEN}"/>
                        </ComboBox>
                        <Button Content="{DynamicResource BtnSaveLanguage}" Height="34" Width="140"
                                HorizontalAlignment="Left" Background="#3A7BFF" Foreground="White"
                                BorderThickness="0" FontSize="13" Click="SaveLanguage_Click"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Firma -->
        <TextBlock Grid.Row="1" Text="Samu3k Dev. 2026 release"
                   FontSize="11" Foreground="{DynamicResource TextSecondary}"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,0,0,4" Opacity="0.6"/>

    </Grid>
</Window>
