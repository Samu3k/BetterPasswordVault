<Window x:Class="BetterPasswordVault.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BetterPasswordVault - Bloccato" Height="380" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}"
        FontFamily="Segoe UI"
        WindowStyle="None"
        Topmost="True">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Icona + Titolo -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
            <TextBlock Text="&#x1F512;" FontSize="52"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock Text="App bloccata" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Inserisci la master password per continuare"
                       FontSize="13" Foreground="{DynamicResource TextSecondary}"
                       HorizontalAlignment="Center" Margin="0,6,0,0"
                       TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>

        <!-- Password -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="Master Password" Foreground="{DynamicResource TextSecondary}"
                       FontSize="13" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PasswordBox" Height="38" FontSize="14"
                         Background="{DynamicResource InputBackground}"
                         Foreground="{DynamicResource TextPrimary}"
                         BorderBrush="{DynamicResource InputBorder}"
                         Padding="12,8"
                         KeyDown="PasswordBox_KeyDown"/>
        </StackPanel>

        <!-- Bottone -->
        <Button Grid.Row="2" Content="Sblocca" Height="42"
                Background="#3A7BFF" Foreground="White"
                BorderThickness="0" FontSize="15" FontWeight="SemiBold"
                Click="Unlock_Click"/>

        <!-- Status -->
        <TextBlock x:Name="StatusText" Grid.Row="3"
                   Foreground="#FF7070" FontSize="13"
                   HorizontalAlignment="Center" Margin="0,14,0,0"/>
    </Grid>
</Window>
